# Copy to .env (git-ignored) and fill in. Never commit real values.
# Load without printing:  set -a; source .env; set +a

# Keenable search/fetch. Discovery reads KEENABLE_API_KEY;
# scripts/run_intake_round.py reads SECRET_KEENABLE_API_KEY (same key value).
KEENABLE_API_KEY=
SECRET_KEENABLE_API_KEY=

# Model providers (extraction/advocates only). OpenRouter is primary; Nebius is
# the fallback after OpenRouter rate limits. See AGENTS.md for model order.
OPENROUTER_API_KEY=
NEBIUS_API_KEY=
META_MODEL_API_KEY=

# Hugging Face dataset publication: scripts/upload_to_huggingface.py
HF_TOKEN=

# GitHub API access for local tooling (gh also honours GH_TOKEN).
GITHUB_TOKEN=

# Archil is retired (see README). Only the historical sandbox code and the
# hackathon docs reference these; current code does not read them.
ARCHIL_API_KEY=
ARCHIL_MOUNT_TOKEN=
ARCHIL_DISK_ID=
ARCHIL_REGION=
