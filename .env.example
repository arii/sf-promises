# Copy to .env (git-ignored) and fill in. Never commit real values.
# Load without printing:  set -a; source .env; set +a

# Keenable search/fetch (discovery and scripts/run_intake_round.py).
KEENABLE_API_KEY=

# Model providers (extraction/advocates only). OpenRouter is primary; Nebius is
# the fallback after OpenRouter rate limits. See AGENTS.md for model order.
OPENROUTER_API_KEY=
NEBIUS_API_KEY=
META_MODEL_API_KEY=

# Hugging Face dataset publication: scripts/upload_to_huggingface.py
HF_TOKEN=

# GitHub API access for local tooling (gh also honours GH_TOKEN).
GITHUB_TOKEN=

# Archil disk holding the shared workspace (promises.db, sources/, staging/).
# Mount it at /mnt/archil; see README "Workspace setup".
ARCHIL_MOUNT_TOKEN=
ARCHIL_DISK_ID=
ARCHIL_REGION=aws-us-east-1
# Archil control-plane API key (disk CLI, API calls); not needed to mount.
ARCHIL_API_KEY=

# Workspace location (default shown).
SF_PROMISES_WORKSPACE=/mnt/archil/workspace
